# Firebase web configuration. These values identify the Firebase web app;
# they are not service-account credentials. Keep actual values in .env.local
# locally and in Vercel/GitHub environment settings for deployment.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
