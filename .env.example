# Firebase web configuration. These values identify the Firebase web app;
# they are not service-account credentials. Keep actual values in .env.local
# locally and in Vercel/GitHub environment settings for deployment.
VITE_FIREBASE_API_KEY=

# Must be the Firebase auth domain, NOT the deployed website URL.
# Correct:   your-project.firebaseapp.com   (or your-project.web.app)
# Incorrect: https://your-app.vercel.app/
# Firebase sends Google sign-in to https://<VITE_FIREBASE_AUTH_DOMAIN>/__/auth/handler,
# so a website URL here breaks "Continue with Google" completely.
VITE_FIREBASE_AUTH_DOMAIN=

VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
