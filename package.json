{
  "name": "vault",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12.0 <25",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "verify": "npm run check && npm run build",
    "emulators": "firebase emulators:start --only auth,firestore --project vault-local",
    "firestore:rules:deploy": "firebase deploy --only firestore:rules"
  },
  "dependencies": {
    "firebase": "13.0.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "firebase-tools": "15.33.0",
    "svelte": "5.57.2",
    "svelte-check": "4.7.6",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
